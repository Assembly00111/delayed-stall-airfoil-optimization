FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// TEMPLATE used by run_domain_sweep.sh (all four sweep studies).
// The capitalised words wrapped in at-signs (the domain corners and the NX/NY
// cell counts) are filled in for every case by the sweep script. Do not edit
// them by hand; to change which domains are run, edit the case list of that
// study near the top of run_domain_sweep.sh.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    // vertices of block 1
    ( @XMIN@  @YMIN@  -0.05)	// vertex 0
    ( @XMIN@  @YMIN@   0.05)	// vertex 1
    ( @XMAX@  @YMIN@  -0.05)	// vertex 2
    ( @XMAX@  @YMIN@   0.05)	// vertex 3
    ( @XMAX@  @YMAX@  -0.05)	// vertex 4
    ( @XMAX@  @YMAX@   0.05)	// vertex 5
    ( @XMIN@  @YMAX@  -0.05)	// vertex 6
    ( @XMIN@  @YMAX@   0.05)	// vertex 7
);

blocks
(
    // background mesh; @NX@/@NY@ scaled with domain size so the far-field
    // cell density stays constant across the sweep (see run_domain_sweep.sh)
    hex ( 0  2  4  6  1  3  5  7) (@NX@ @NY@ 1) simpleGrading (1 1 1)
);

boundary
(
    Top
    {
        type patch;
        faces
        (
            ( 6  4  5  7) // top
        );
    }

    Bottom
    {
        type patch;
        faces
        (
            ( 0  2  3  1) // bottom
        );
    }

    Inlet
    {
        type patch;
        faces
        (
            ( 0  1  7  6)
        );
    }

    Outlet
    {
        type patch;
        faces
        (
            ( 2  3  5  4)
        );
    }

    Front
    {
        type patch;
        faces
        (
            ( 0  2  4  6)
        );
    }

    Back
    {
        type patch;
        faces
        (
            ( 1  3  5  7)
        );
    }
);


mergePatchPairs
(
);



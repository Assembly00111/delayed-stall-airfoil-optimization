FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// TEMPLATE for mesh-independence sweep.
// Placeholders @WING_LMIN@ @WING_LMAX@ @BOX1_LEVEL@ @BOX2_LEVEL@ @BOX3_LEVEL@
// are substituted by run_mesh_sweep.sh. Do not edit them by hand; edit the
// MESHES array at the top of run_mesh_sweep.sh instead. Box extents and
// everything else are left identical to the original case so that only
// refinement density changes between runs.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Which of the steps to run
castellatedMesh true;
snap            true;
addLayers       true;


geometry
{
    wing
    {
        type    triSurfaceMesh;
        file    "cylinder_2d.obj";
    }

    refinementBox1
    {
        type    searchableBox;
        // min x is @BOX1_XMIN@ = the domain's own XMIN (no buffer), so this
        // box always starts exactly at the inlet regardless of domain size.
        // A fixed absolute coordinate here previously caused the box to sit
        // ON the inlet for small domains but far from it for large ones --
        // an inconsistent, growing coarse-to-fine transition length that
        // correlated with worse mesh quality (higher non-orthogonality/
        // skewness) and numerical noise for the largest domain tested.
        // Starting at the inlet every time removes that inconsistency.
        min     (@BOX1_XMIN@  -4 -1);
        max     (25   4  1);
    }

    refinementBox2
    {
        type    searchableBox;
        min     (-2  -3 -1);
        max     (10   3  1);
    }

    refinementBox3
    {
        type    searchableBox;
        min     (-1  -2 -1);
        max     ( 5   2  1);
    }

};



castellatedMeshControls
{
    maxLocalCells 5000000;
    maxGlobalCells 100000000;
    minRefinementCells 100;
    nCellsBetweenLevels 2;

    features ();

    refinementSurfaces
    {
        wing
        {
            // Surface-wise min and max refinement level -- SWEPT PARAMETER
            level (@WING_LMIN@ @WING_LMAX@);
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        refinementBox1
        {
            mode inside;
            level @BOX1_LEVEL@;
        }

        refinementBox2
        {
            mode inside;
            level @BOX2_LEVEL@;
        }

        refinementBox3
        {
            mode inside;
            level @BOX3_LEVEL@;
        }

    }

    // Point must lie inside the fluid region for THIS case's domain -- fixed
    // at -5 in the original case, but that breaks for any domain sweep whose
    // XMIN isn't -5. run_domain_sweep.sh / run_mesh_sweep.sh substitute this
    // as (XMIN + 1) so it's always safely upstream of the wing and inside
    // whatever domain size is being tested.
    locationInMesh (@LOCX@ @LOCY@ 0);

    allowFreeStandingZoneFaces true;
}



snapControls
{
    nSmoothPatch 3;
    tolerance 4.0;
    nSolveIter 30;
    nRelaxIter 5;
}



addLayersControls
{
    relativeSizes true;

    layers
    {
        wing
        {
            nSurfaceLayers 3;
        }
    }

    expansionRatio 1.3;
    finalLayerThickness 2.5;
    minThickness 0.25;
    nGrow 0;

    featureAngle 60;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedianAxisAngle 90;
    nBufferCellsNoExtrude 0;

    nLayerIter 50;
}



meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol -1e30;
    minTetQuality 1e-30;
    minTwist 0.05;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;

    nSmoothScale 4;
    errorReduction 0.75;
}


mergeTolerance 1e-6;


